<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ZFood.App.ViewModels"
        xmlns:core="using:ZFood.Core"
        xmlns:views="using:ZFood.App.Views"
        x:Class="ZFood.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="ZFood"
        Icon="/Assets/zfood.png"
        Width="880" Height="920"
        MinWidth="720" MinHeight="700"
        Background="{DynamicResource WindowBrush}">

    <Window.Styles>
        <!-- The accent marker bar carried by the dish row alone. -->
        <Style Selector="Border.dishBar">
            <Setter Property="Background" Value="{DynamicResource DishBarBrush}" />
            <Setter Property="BoxShadow" Value="{DynamicResource DishBarShadow}" />
            <Setter Property="Width" Value="4" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Margin" Value="0,6" />
        </Style>

        <!-- Cookware rows: empty rows are dim ghosts, the dish row is emphasized.
             Tall windows (the "roomy" window class) relax the vertical rhythm. -->
        <Style Selector="Grid.cookwareRow">
            <Setter Property="Height" Value="38" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Window.roomy Grid.cookwareRow">
            <Setter Property="Height" Value="44" />
        </Style>
        <Style Selector="StackPanel.waterStack">
            <Setter Property="Spacing" Value="10" />
        </Style>
        <Style Selector="Window.roomy StackPanel.waterStack">
            <Setter Property="Spacing" Value="14" />
        </Style>
        <Style Selector="Grid.cookwareRow.dim">
            <Setter Property="Opacity" Value="{DynamicResource GhostRowOpacity}" />
        </Style>
        <Style Selector="Grid.cookwareRow.dish">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="Background" Value="{DynamicResource DishRowBrush}" />
        </Style>
        <Style Selector="Grid.cookwareRow.dish TextBlock.cookwareName">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.cookwareName">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Narrow windows drop the density hero under the fields so it never
             collides with the use-dish-net button. The default grid cell is
             styled (not set inline) so the narrow preset can override it. -->
        <Style Selector="Panel#DensityHeroPanel">
            <Setter Property="Grid.Row" Value="0" />
            <Setter Property="Grid.Column" Value="1" />
            <Setter Property="Grid.ColumnSpan" Value="1" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Window.narrow Panel#DensityHeroPanel">
            <Setter Property="Grid.Row" Value="1" />
            <Setter Property="Grid.Column" Value="0" />
            <Setter Property="Grid.ColumnSpan" Value="2" />
            <Setter Property="Margin" Value="0,12,0,0" />
        </Style>

        <!-- The density hero: halo behind, an optional chip surface, and the
             large light numerals. Most themes leave halo and chip invisible. -->
        <Style Selector="Border.heroHalo">
            <Setter Property="Background" Value="{DynamicResource HeroHaloBrush}" />
            <Setter Property="Width" Value="200" />
            <Setter Property="Height" Value="130" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.heroChip">
            <Setter Property="Background" Value="{DynamicResource HeroChipBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource HeroChipBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource HeroChipCornerRadius}" />
            <Setter Property="BoxShadow" Value="{DynamicResource HeroChipShadow}" />
            <Setter Property="Padding" Value="{DynamicResource HeroChipPadding}" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.heroChip.placeholder">
            <Setter Property="Background" Value="{DynamicResource HeroChipPlaceholderBrush}" />
        </Style>
        <Style Selector="Border.heroChip.pulse">
            <Setter Property="Background" Value="{DynamicResource HeroChipPulseBrush}" />
        </Style>
        <Style Selector="TextBlock.hero">
            <Setter Property="Foreground" Value="{DynamicResource HeroBrush}" />
            <Setter Property="FontFamily" Value="{DynamicResource HeroFontFamily}" />
            <Setter Property="FontWeight" Value="{DynamicResource HeroFontWeight}" />
        </Style>
        <Style Selector="TextBlock.hero.placeholder">
            <Setter Property="Foreground" Value="{DynamicResource HeroPlaceholderBrush}" />
        </Style>
        <Style Selector="TextBlock.heroUnit">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource HeroUnitBrush}" />
        </Style>

        <!-- Pulse-capable text readouts (the dish caption). -->
        <Style Selector="TextBlock.pulseable">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="TextBlock.pulseable.pulse">
            <Setter Property="Background" Value="{DynamicResource PulseBrush}" />
        </Style>

        <!-- Below-tare hint. -->
        <Style Selector="TextBlock.belowTare">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource WarnBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Pin stars: pure glyph buttons outside the tab order. -->
        <Style Selector="Button.star">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="MinWidth" Value="34" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="{DynamicResource StarBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.star.pinned">
            <Setter Property="Foreground" Value="{DynamicResource StarPinnedBrush}" />
        </Style>

        <!-- Column headers naming the two weight columns. -->
        <Style Selector="TextBlock.columnHeader">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="LetterSpacing" Value="1.4" />
            <Setter Property="Foreground" Value="{DynamicResource FaintBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- The dish caption in the water section. -->
        <Style Selector="TextBlock.dishCaption">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{DynamicResource DishCaptionBrush}" />
        </Style>

        <!-- Log rows. -->
        <Style Selector="ListBox.logList">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="ListBox.logList ListBoxItem">
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="MinHeight" Value="26" />
        </Style>
        <Style Selector="TextBlock.logResult">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
            <Setter Property="TextAlignment" Value="Right" />
        </Style>
        <Style Selector="TextBlock.logEquation">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource SubtleBrush}" />
        </Style>
        <Style Selector="Border.tagPill">
            <Setter Property="Background" Value="{DynamicResource TagPillBrush}" />
            <Setter Property="Padding" Value="{DynamicResource TagPillPadding}" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.tagPill TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource TagPillTextBrush}" />
        </Style>

        <!-- The scale card's flex band and the delta's tall-size reflection. -->
        <Style Selector="Border#ScaleFlexBand">
            <Setter Property="Background" Value="{DynamicResource FlexBandBrush}" />
        </Style>
        <Style Selector="Border#DeltaReflection">
            <Setter Property="Background" Value="{DynamicResource DeltaReflectionBrush}" />
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="Window.roomy Border#DeltaReflection">
            <Setter Property="IsVisible" Value="True" />
        </Style>

        <!-- Status bar. -->
        <Style Selector="Border.statusBar">
            <Setter Property="Background" Value="{DynamicResource StatusBarBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource StatusBarBorderBrush}" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
            <Setter Property="CornerRadius" Value="{DynamicResource StatusBarCornerRadius}" />
            <Setter Property="Padding" Value="{DynamicResource StatusBarPadding}" />
            <Setter Property="BoxShadow" Value="{DynamicResource StatusBarShadow}" />
        </Style>
        <Style Selector="TextBlock.statusEcho">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
        </Style>
        <Style Selector="TextBlock.notice">
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
        </Style>
        <Style Selector="TextBlock.notice.warnNotice">
            <Setter Property="Foreground" Value="{DynamicResource WarnBrush}" />
        </Style>

        <!-- The header wordmark and the rule under the header. -->
        <Style Selector="TextBlock.wordmark">
            <Setter Property="Foreground" Value="{DynamicResource WordmarkBrush}" />
            <Setter Property="FontFamily" Value="{DynamicResource WordmarkFontFamily}" />
            <Setter Property="FontSize" Value="{DynamicResource WordmarkFontSize}" />
            <Setter Property="FontWeight" Value="{DynamicResource WordmarkFontWeight}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.headerRule">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{DynamicResource HeaderRuleBrush}" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
    </Window.Styles>

    <Panel>
        <!-- Theme atmosphere layers (invisible in themes that leave them
             transparent); drawn behind everything, never hit-testable. -->
        <Border Background="{DynamicResource CanvasBloom1Brush}" IsHitTestVisible="False" />
        <Border Background="{DynamicResource CanvasBloom2Brush}" IsHitTestVisible="False" />
        <Border Background="{DynamicResource CanvasBloom3Brush}" IsHitTestVisible="False" />

        <DockPanel Margin="18,14,18,10">

        <!-- Header -->
        <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto,Auto,Auto" Margin="2,0,2,5">
            <TextBlock Grid.Column="0" Classes="wordmark" Text="ZFood" />
            <Button Grid.Column="2" x:Name="ResetButton" Classes="quiet" Content="Reset"
                    ToolTip.Tip="Clear all entered numbers (Ctrl+R)" Margin="0,0,8,0" Click="OnResetClick" />
            <Button Grid.Column="3" x:Name="LogButton" Classes="quiet" Content="Log"
                    ToolTip.Tip="Show the calculation log (Ctrl+L)" Margin="0,0,8,0" Click="OnLogClick" />
            <Button Grid.Column="4" x:Name="GearButton" Classes="quiet" Content="⚙"
                    FontSize="15" Padding="10,4" ToolTip.Tip="Cookware and theme settings" Click="OnGearClick" />
        </Grid>
        <Border DockPanel.Dock="Top" Classes="headerRule" Margin="0,0,0,6" />

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Classes="statusBar" Margin="0,8,0,0">
            <Grid ColumnDefinitions="Auto,10,Auto,*,Auto">
                <TextBlock Grid.Column="0" Classes="statusEcho" Text="{Binding StatusEcho}" />
                <TextBlock Grid.Column="2" Classes="unit" Text="{Binding StatusTime}" />
                <TextBlock Grid.Column="4" Classes="notice" FontSize="13"
                           Classes.warnNotice="{Binding StatusNoticeIsWarning}"
                           Text="{Binding StatusNotice}" />
            </Grid>
        </Border>

        <!-- LOG card -->
        <Border DockPanel.Dock="Bottom" Classes="card recessed" Margin="0,12,0,0">
            <Panel>
                <Border Classes="cardGloss" />
                <Border Classes="cardHighlight" />
                <StackPanel Margin="20,12,20,10">
                <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,4">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Path Classes="sectionMark" />
                        <TextBlock Classes="sectionTitle" Text="LOG" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Classes="unit" FontSize="11"
                               Text="click a row to copy its result" />
                </Grid>
                <ListBox x:Name="RecentLogList" Classes="logList" IsVisible="{Binding !LogDrawerOpen}"
                         ItemsSource="{Binding Log.Recent}" Height="82"
                         IsTabStop="False" KeyboardNavigation.TabNavigation="None"
                         Tapped="OnLogListTapped" KeyDown="OnLogListKeyDown">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:LogRow">
                            <Grid ColumnDefinitions="140,86,72,*">
                                <TextBlock Grid.Column="0" Classes="unit" FontFeatures="+tnum" Text="{Binding Time}" />
                                <TextBlock Grid.Column="1" Classes="logResult"
                                           FontFeatures="+tnum" Text="{Binding Result}" Margin="0,0,12,0" />
                                <Border Grid.Column="2" Classes="tagPill">
                                    <TextBlock Text="{Binding Kind}" />
                                </Border>
                                <TextBlock Grid.Column="3" Classes="logEquation"
                                           Text="{Binding Equation}" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Border IsVisible="{Binding LogDrawerOpen}" Height="208">
                    <ScrollViewer>
                        <ListBox x:Name="DrawerLogList" Classes="logList" ItemsSource="{Binding Log.Drawer}"
                                 IsTabStop="False" KeyboardNavigation.TabNavigation="None"
                                 Tapped="OnLogListTapped" KeyDown="OnLogListKeyDown">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:LogRow">
                                    <Grid ColumnDefinitions="140,86,72,*">
                                        <TextBlock Grid.Column="0" Classes="unit" FontFeatures="+tnum" Text="{Binding Time}" />
                                        <TextBlock Grid.Column="1" Classes="logResult"
                                                   FontFeatures="+tnum" Text="{Binding Result}" Margin="0,0,12,0" />
                                        <Border Grid.Column="2" Classes="tagPill">
                                            <TextBlock Text="{Binding Kind}" />
                                        </Border>
                                        <TextBlock Grid.Column="3" Classes="logEquation"
                                                   Text="{Binding Equation}" TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>
                </Border>
                </StackPanel>
            </Panel>
        </Border>

        <!-- PORTION card -->
        <Border DockPanel.Dock="Top" Classes="card" Margin="0,0,0,12">
            <Panel>
                <Border Classes="cardGloss" />
                <Border Classes="cardHighlight" />
                <Border Classes="cardContent">
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                <StackPanel Grid.Column="0" Spacing="10">
                    <Grid RowDefinitions="Auto,Auto" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Path Classes="sectionMark" />
                            <TextBlock Classes="sectionTitle" Text="PORTION" />
                        </StackPanel>
                        <Border Grid.Row="1" Classes="sectionUnderline" />
                    </Grid>
                    <!-- Columns mirror the cookware rows below so every numeral sits
                         on one shared grid across both cards. -->
                    <Grid x:Name="PortionPanel" ColumnDefinitions="186,52,Auto,24,Auto,26,Auto"
                          RowDefinitions="Auto,10,Auto">
                        <TextBlock Grid.Row="0" Grid.Column="0" Classes="fieldLabel" Text="Serving" Margin="6,0,0,0" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Classes="unit" Text="grams" Margin="0,0,8,0"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                        <TextBox Grid.Row="0" Grid.Column="2" x:Name="ServingGramsBox" Classes="numeric"
                                 Text="{Binding Portion.ServingGramsText}">
                            <TextBox.InnerRightContent>
                                <Button Classes="copyIcon" Click="OnCopyIconClick" ToolTip.Tip="Copy this number">
                                    <Path />
                                </Button>
                            </TextBox.InnerRightContent>
                        </TextBox>
                        <TextBlock Grid.Row="0" Grid.Column="3" Classes="unit" Text="=" TextAlignment="Center"
                                   VerticalAlignment="Center" />
                        <TextBox Grid.Row="0" Grid.Column="4" x:Name="ServingCaloriesBox" Classes="numeric"
                                 Text="{Binding Portion.ServingCaloriesText}">
                            <TextBox.InnerRightContent>
                                <Button Classes="copyIcon" Click="OnCopyIconClick" ToolTip.Tip="Copy this number">
                                    <Path />
                                </Button>
                            </TextBox.InnerRightContent>
                        </TextBox>
                        <TextBlock Grid.Row="0" Grid.Column="5" Classes="unit" Text="cal" Margin="6,0,0,0" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Classes="fieldLabel" Text="Eaten" Margin="6,0,0,0" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Classes="unit" Text="grams" Margin="0,0,8,0"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                        <TextBox Grid.Row="2" Grid.Column="2" x:Name="EatenGramsBox" Classes="numeric"
                                 Classes.computed="{Binding Portion.EatenGramsIsComputed}"
                                 Text="{Binding Portion.EatenGramsText}">
                            <TextBox.InnerRightContent>
                                <Button Classes="copyIcon" Click="OnCopyIconClick" ToolTip.Tip="Copy this number">
                                    <Path />
                                </Button>
                            </TextBox.InnerRightContent>
                        </TextBox>
                        <TextBlock Grid.Row="2" Grid.Column="3" Classes="unit" Text="⇄" TextAlignment="Center"
                                   VerticalAlignment="Center" />
                        <TextBox Grid.Row="2" Grid.Column="4" x:Name="EatenCaloriesBox" Classes="numeric"
                                 Classes.computed="{Binding Portion.EatenCaloriesIsComputed}"
                                 Text="{Binding Portion.EatenCaloriesText}">
                            <TextBox.InnerRightContent>
                                <Button Classes="copyIcon" Click="OnCopyIconClick" ToolTip.Tip="Copy this number">
                                    <Path />
                                </Button>
                            </TextBox.InnerRightContent>
                        </TextBox>
                        <TextBlock Grid.Row="2" Grid.Column="5" Classes="unit" Text="cal" Margin="6,0,0,0" />
                        <Button Grid.Row="2" Grid.Column="6" x:Name="UseDishNetButton" Classes="quiet"
                                Margin="16,0,0,0" MaxWidth="150" Content="{Binding UseDishNetLabel}"
                                IsEnabled="{Binding CanUseDishNet}"
                                ToolTip.Tip="Copy the dish row's net weight into eaten grams"
                                Click="OnUseDishNetClick" />
                    </Grid>
                </StackPanel>

                <!-- Density hero: the instrument's main display. -->
                <Panel x:Name="DensityHeroPanel">
                    <Border Classes="heroHalo" />
                    <Border x:Name="DensityChip" Classes="heroChip"
                            Classes.placeholder="{Binding Portion.DensityIsPlaceholder}">
                        <StackPanel Spacing="0">
                            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                                <TextBlock x:Name="DensityHero" Classes="hero"
                                           Classes.placeholder="{Binding Portion.DensityIsPlaceholder}"
                                           Text="{Binding Portion.DensityCalPerG}"
                                           FontSize="46" FontFeatures="+tnum" />
                                <TextBlock Classes="heroUnit" Text="cal/g" VerticalAlignment="Bottom" Margin="0,0,0,9" />
                            </StackPanel>
                            <TextBlock HorizontalAlignment="Right" Classes="heroUnit"
                                       Text="{Binding Portion.DensityPer100, StringFormat='{}{0} cal / 100 g'}" />
                        </StackPanel>
                    </Border>
                </Panel>
                </Grid>
                </Border>
            </Panel>
        </Border>

        <!-- SCALE card -->
        <Border Classes="card">
            <Panel>
                <Border Classes="cardGloss" />
                <Border Classes="cardHighlight" />
                <Border Classes="cardContent">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <!-- The water section is pinned to the card's base like the
                     display at the foot of a kitchen scale: at tall window
                     sizes the surplus opens in the flex band between the
                     cookware rows and the water block instead of leaving a
                     dead margin under the delta. The MinHeight binding makes
                     the band engage when there is room while the ScrollViewer
                     still guards short windows. -->
                <Grid RowDefinitions="Auto,*,Auto"
                      MinHeight="{Binding $parent[ScrollViewer].Viewport.Height}">
                <StackPanel Grid.Row="0">
                    <Grid RowDefinitions="Auto,Auto" HorizontalAlignment="Left" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Path Classes="sectionMark" />
                            <TextBlock Classes="sectionTitle" Text="SCALE" />
                        </StackPanel>
                        <Border Grid.Row="1" Classes="sectionUnderline" />
                    </Grid>

                    <!-- Which column is which weight: the first field holds the
                         scale reading including the cookware, the second the
                         food alone. -->
                    <Grid ColumnDefinitions="8,178,52,104,24,104,26,*" Margin="0,0,0,4">
                        <TextBlock Grid.Column="3" x:Name="WithCookwareHeader" Classes="columnHeader"
                                   Text="WITH COOKWARE" />
                        <TextBlock Grid.Column="5" x:Name="FoodOnlyHeader" Classes="columnHeader"
                                   Text="FOOD ONLY" />
                    </Grid>

                    <!-- Cookware rows -->
                    <ItemsControl x:Name="CookwareRowsControl" ItemsSource="{Binding Scale.Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="core:CookwareRowModel">
                                <Grid Classes="cookwareRow" Classes.dish="{Binding IsDish}" Classes.dim="{Binding IsEmpty}"
                                      ColumnDefinitions="8,178,52,Auto,24,Auto,26,Auto,*,36">
                                    <Border Grid.Column="0" Classes="dishBar" IsVisible="{Binding IsDish}" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                                                VerticalAlignment="Center" Margin="6,0,0,0">
                                        <TextBlock Classes="cookwareName" Text="{Binding Name}" />
                                        <TextBlock Classes="unit" FontSize="11" Text="{Binding TareEcho}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Classes="unit" Text="weight" Margin="0,0,8,0"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"
                                               IsVisible="{Binding IsNoCookware}" />
                                    <TextBox Grid.Column="3" Classes="numeric rowGross"
                                             Classes.computed="{Binding GrossIsComputed}"
                                             Text="{Binding GrossText}"
                                             views:Pulse.Tick="{Binding ComputedPulse}">
                                        <TextBox.InnerRightContent>
                                            <Button Classes="copyIcon" Click="OnCopyIconClick" ToolTip.Tip="Copy this number">
                                                <Path />
                                            </Button>
                                        </TextBox.InnerRightContent>
                                    </TextBox>
                                    <TextBlock Grid.Column="4" Classes="unit" Text="⇄" TextAlignment="Center"
                                               VerticalAlignment="Center" IsVisible="{Binding !IsNoCookware}" />
                                    <TextBox Grid.Column="5" Classes="numeric rowNet"
                                             Classes.computed="{Binding NetIsComputed}"
                                             Classes.warn="{Binding BelowTare}"
                                             Text="{Binding NetText}"
                                             views:Pulse.Tick="{Binding ComputedPulse}"
                                             IsVisible="{Binding !IsNoCookware}">
                                        <TextBox.InnerRightContent>
                                            <Button Classes="copyIcon" Click="OnCopyIconClick" ToolTip.Tip="Copy this number">
                                                <Path />
                                            </Button>
                                        </TextBox.InnerRightContent>
                                    </TextBox>
                                    <TextBlock Grid.Column="6" Classes="unit" Text="g" Margin="6,0,0,0"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="7" Classes="belowTare" Margin="10,0,0,0"
                                               Text="below tare, wrong cookware?" IsVisible="{Binding BelowTare}" />
                                    <Button Grid.Column="9" Classes="star" Classes.pinned="{Binding Pinned}"
                                            IsVisible="{Binding !IsNoCookware}" Click="OnStarClick"
                                            ToolTip.Tip="Pin or unpin this cookware">
                                        <Panel>
                                            <TextBlock Text="★" IsVisible="{Binding Pinned}" />
                                            <TextBlock Text="☆" IsVisible="{Binding !Pinned}" />
                                        </Panel>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel IsVisible="{Binding MoreCookwareVisible}" Margin="8,4,0,0">
                        <Button x:Name="MoreCookwareToggle" Classes="linklike" Click="OnMoreCookwareToggleClick"
                                ToolTip.Tip="Rarely used cookware (Alt+M)">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="▸" FontSize="10" VerticalAlignment="Center"
                                           IsVisible="{Binding !MoreCookwareOpen}" />
                                <TextBlock Text="▾" FontSize="10" VerticalAlignment="Center"
                                           IsVisible="{Binding MoreCookwareOpen}" />
                                <TextBlock Text="{Binding MoreCookwareHeader}" />
                            </StackPanel>
                        </Button>
                        <ListBox x:Name="MoreCookwareList" Classes="logList" ItemsSource="{Binding Scale.AvailableCookware}"
                                 IsVisible="{Binding MoreCookwareOpen}" Margin="16,2,0,0"
                                 IsTabStop="False" KeyboardNavigation.TabNavigation="None"
                                 Tapped="OnMoreCookwareTapped" KeyDown="OnMoreCookwareKeyDown">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="core:Cookware">
                                    <StackPanel Orientation="Horizontal" Spacing="10" Height="24">
                                        <TextBlock Foreground="{DynamicResource InkBrush}" Text="{Binding Name}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Classes="unit" FontSize="11" VerticalAlignment="Center"
                                                   Text="{Binding Grams, StringFormat='tare {0} g'}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </StackPanel>

                <!-- Flex band: absorbs surplus card height at tall sizes. -->
                <Border Grid.Row="1" x:Name="ScaleFlexBand" IsHitTestVisible="False" MinHeight="0" />

                <!-- Water section -->
                <StackPanel Grid.Row="2">
                    <Border Classes="hairline shelfRule" Margin="0,10,0,10" />
                    <TextBlock x:Name="DishCaptionText" Classes="dishCaption pulseable"
                               Text="{Binding Scale.DishCaption}" Margin="8,0,0,10" />
                    <!-- The 238 px label column lines the water boxes up with the
                         cookware rows' first weight column; the delta's right
                         edge meets the second column's right edge. -->
                    <StackPanel Classes="waterStack">
                        <Grid ColumnDefinitions="238,232,28">
                            <TextBlock Grid.Column="0" Classes="fieldLabel" Text="Recipe weight" Margin="8,0,0,0" />
                            <TextBox Grid.Column="1" x:Name="RecipeBox" Classes="numeric"
                                     HorizontalAlignment="Right"
                                     Text="{Binding Scale.RecipeText}">
                                <TextBox.InnerRightContent>
                                    <Button Classes="copyIcon" Click="OnCopyIconClick" ToolTip.Tip="Copy this number">
                                        <Path />
                                    </Button>
                                </TextBox.InnerRightContent>
                            </TextBox>
                            <TextBlock Grid.Column="2" Classes="unit" Text="g" Margin="6,0,0,0" />
                        </Grid>
                        <StackPanel>
                            <Grid ColumnDefinitions="238,232,28">
                                <TextBlock Grid.Column="0" Classes="fieldLabel" Text="Water to add" Margin="8,0,0,0" />
                                <TextBox Grid.Column="1" x:Name="DeltaBox" Classes="numeric computed delta"
                                         IsReadOnly="True" Text="{Binding Scale.DeltaText, Mode=OneWay}"
                                         views:Pulse.Tick="{Binding Scale.DeltaPulse}">
                                    <TextBox.InnerRightContent>
                                        <Button x:Name="DeltaCopyButton" Classes="copyIcon"
                                                Click="OnDeltaCopyIconClick"
                                                ToolTip.Tip="Copy the bare signed number (Enter in the recipe field also copies)">
                                            <Path />
                                        </Button>
                                    </TextBox.InnerRightContent>
                                </TextBox>
                                <TextBlock Grid.Column="2" Classes="unit" Text="g" Margin="6,0,0,0" />
                            </Grid>
                            <!-- At tall sizes some themes reflect the delta on
                                 the surface beneath it. -->
                            <Grid ColumnDefinitions="238,232,28">
                                <Border Grid.Column="1" x:Name="DeltaReflection" Height="12"
                                        CornerRadius="12" Margin="0,2,0,0" IsHitTestVisible="False" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
                </Grid>
                </ScrollViewer>
                </Border>
            </Panel>
        </Border>
        </DockPanel>
    </Panel>
</Window>
