<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ZFood.App.ViewModels"
        xmlns:core="using:ZFood.Core"
        xmlns:views="using:ZFood.App.Views"
        x:Class="ZFood.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="ZFood"
        Icon="/Assets/zfood.png"
        Width="980" Height="620"
        MinWidth="800" MinHeight="460"
        Background="{DynamicResource WindowBrush}">

    <Window.Styles>
        <!-- Vertical section labels: the rotated title runs along the left
             edge of its section under the theme's section mark. -->
        <Style Selector="StackPanel.sectionLabel">
            <Setter Property="Spacing" Value="10" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="0,4,12,0" />
        </Style>

        <!-- The accent marker bar carried by the dish row alone. -->
        <Style Selector="Border.dishBar">
            <Setter Property="Background" Value="{DynamicResource DishBarBrush}" />
            <Setter Property="BoxShadow" Value="{DynamicResource DishBarShadow}" />
            <Setter Property="Width" Value="4" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Margin" Value="0,6" />
        </Style>

        <!-- Cookware rows: empty rows are dim ghosts, the dish row is emphasized.
             Tall windows (the "roomy" window class) relax the vertical rhythm. -->
        <Style Selector="Grid.cookwareRow">
            <Setter Property="Height" Value="38" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Window.roomy Grid.cookwareRow">
            <Setter Property="Height" Value="44" />
        </Style>
        <Style Selector="Grid.cookwareRow.dim">
            <Setter Property="Opacity" Value="{DynamicResource GhostRowOpacity}" />
        </Style>
        <Style Selector="Grid.cookwareRow.dish">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="Background" Value="{DynamicResource DishRowBrush}" />
        </Style>
        <Style Selector="Grid.cookwareRow.dish TextBlock.cookwareName">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.cookwareName">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- The water section: a compact column beside the cookware rows at
             comfortable widths; stacked back below them on narrow windows. -->
        <Style Selector="StackPanel#WaterColumn">
            <Setter Property="Grid.Row" Value="0" />
            <Setter Property="Grid.Column" Value="2" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <Style Selector="Window.narrow StackPanel#WaterColumn">
            <Setter Property="Grid.Row" Value="1" />
            <Setter Property="Grid.Column" Value="0" />
            <Setter Property="Margin" Value="26,12,0,0" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style Selector="Border#WaterDivider">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="Window.narrow Border#WaterDivider">
            <Setter Property="IsVisible" Value="False" />
        </Style>

        <!-- The density readout: a compact chip in the serving row's height
             class; still the boldest text of the section. -->
        <Style Selector="Border.heroChip">
            <Setter Property="Background" Value="{DynamicResource HeroChipBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource HeroChipBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource HeroChipCornerRadius}" />
            <Setter Property="BoxShadow" Value="{DynamicResource HeroChipShadow}" />
            <Setter Property="Padding" Value="{DynamicResource HeroChipPadding}" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.heroChip.placeholder">
            <Setter Property="Background" Value="{DynamicResource HeroChipPlaceholderBrush}" />
        </Style>
        <Style Selector="Border.heroChip.pulse">
            <Setter Property="Background" Value="{DynamicResource HeroChipPulseBrush}" />
        </Style>
        <Style Selector="TextBlock.hero">
            <Setter Property="Foreground" Value="{DynamicResource HeroBrush}" />
            <Setter Property="FontFamily" Value="{DynamicResource HeroFontFamily}" />
            <Setter Property="FontWeight" Value="{DynamicResource HeroFontWeight}" />
        </Style>
        <Style Selector="TextBlock.hero.placeholder">
            <Setter Property="Foreground" Value="{DynamicResource HeroPlaceholderBrush}" />
        </Style>
        <Style Selector="TextBlock.heroUnit">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource HeroUnitBrush}" />
        </Style>
        <Style Selector="Border.heroChip.placeholder TextBlock.heroUnit">
            <Setter Property="Foreground" Value="{DynamicResource HeroPlaceholderBrush}" />
        </Style>

        <!-- Pulse-capable text readouts (the dish caption). -->
        <Style Selector="TextBlock.pulseable">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="TextBlock.pulseable.pulse">
            <Setter Property="Background" Value="{DynamicResource PulseBrush}" />
        </Style>

        <!-- Below-tare hint. -->
        <Style Selector="TextBlock.belowTare">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource WarnBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Pin stars: small glyph buttons at the row's left edge, outside the
             tab order. -->
        <Style Selector="Button.star">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="2,0" />
            <Setter Property="MinWidth" Value="22" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource StarBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.star.pinned">
            <Setter Property="Foreground" Value="{DynamicResource StarPinnedBrush}" />
        </Style>

        <!-- Column headers naming the two weight columns. -->
        <Style Selector="TextBlock.columnHeader">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="LetterSpacing" Value="1.4" />
            <Setter Property="Foreground" Value="{DynamicResource FaintBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- The dish caption in the water section. -->
        <Style Selector="TextBlock.dishCaption">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{DynamicResource DishCaptionBrush}" />
        </Style>

        <!-- Log rows. -->
        <Style Selector="ListBox.logList">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="ListBox.logList ListBoxItem">
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="MinHeight" Value="26" />
        </Style>
        <Style Selector="TextBlock.logResult">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
            <Setter Property="TextAlignment" Value="Right" />
        </Style>
        <Style Selector="TextBlock.logEquation">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource SubtleBrush}" />
        </Style>
        <Style Selector="Border.tagPill">
            <Setter Property="Background" Value="{DynamicResource TagPillBrush}" />
            <Setter Property="Padding" Value="{DynamicResource TagPillPadding}" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.tagPill TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource TagPillTextBrush}" />
        </Style>

        <!-- The on-demand log view floating over the work area. -->
        <Style Selector="Border.logOverlay">
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>

        <!-- The scale card's flex band and the delta's tall-size reflection. -->
        <Style Selector="Border#ScaleFlexBand">
            <Setter Property="Background" Value="{DynamicResource FlexBandBrush}" />
        </Style>
        <Style Selector="Border#DeltaReflection">
            <Setter Property="Background" Value="{DynamicResource DeltaReflectionBrush}" />
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="Window.roomy Border#DeltaReflection">
            <Setter Property="IsVisible" Value="True" />
        </Style>

        <!-- Status bar: the newest log entry, quiet notices, and the three
             icon buttons docked at the right. -->
        <Style Selector="Border.statusBar">
            <Setter Property="Background" Value="{DynamicResource StatusBarBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource StatusBarBorderBrush}" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
            <Setter Property="CornerRadius" Value="{DynamicResource StatusBarCornerRadius}" />
            <Setter Property="Padding" Value="{DynamicResource StatusBarPadding}" />
            <Setter Property="BoxShadow" Value="{DynamicResource StatusBarShadow}" />
        </Style>
        <Style Selector="SelectableTextBlock.statusEcho">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource SelectionBrush}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="TextBlock.notice">
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
        </Style>
        <Style Selector="TextBlock.notice.warnNotice">
            <Setter Property="Foreground" Value="{DynamicResource WarnBrush}" />
        </Style>
    </Window.Styles>

    <Panel>
        <!-- Theme atmosphere layers (invisible in themes that leave them
             transparent); drawn behind everything, never hit-testable. -->
        <Border Background="{DynamicResource CanvasBloom1Brush}" IsHitTestVisible="False" />
        <Border Background="{DynamicResource CanvasBloom2Brush}" IsHitTestVisible="False" />
        <Border Background="{DynamicResource CanvasBloom3Brush}" IsHitTestVisible="False" />

        <Grid RowDefinitions="*,Auto" Margin="16,12,16,8">

        <!-- Work area: the two cards, with the log view floating over them
             when it is open. -->
        <Panel Grid.Row="0">
        <DockPanel>

        <!-- PORTION card -->
        <Border DockPanel.Dock="Top" Classes="card" Margin="0,0,0,10">
            <Panel>
                <Border Classes="cardGloss" />
                <Border Classes="cardHighlight" />
                <Border Classes="cardContent">
                <Grid ColumnDefinitions="Auto,*">
                    <StackPanel Classes="sectionLabel">
                        <Path Classes="sectionMark" HorizontalAlignment="Center" />
                        <LayoutTransformControl HorizontalAlignment="Center">
                            <LayoutTransformControl.LayoutTransform>
                                <RotateTransform Angle="-90" />
                            </LayoutTransformControl.LayoutTransform>
                            <TextBlock Classes="sectionTitle" Text="PORTION" />
                        </LayoutTransformControl>
                    </StackPanel>

                    <Grid Grid.Column="1" x:Name="PortionPanel"
                          ColumnDefinitions="56,50,104,24,104,30,*"
                          RowDefinitions="Auto,6,Auto">
                        <TextBlock Grid.Row="0" Grid.Column="0" Classes="fieldLabel" Text="Serving" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Classes="unit" Text="grams" Margin="0,0,8,0"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                        <TextBox Grid.Row="0" Grid.Column="2" x:Name="ServingGramsBox" Classes="numeric"
                                 Text="{Binding Portion.ServingGramsText}">
                            <TextBox.InnerRightContent>
                                <Button Classes="copyIcon" Click="OnCopyIconClick" ToolTip.Tip="Copy this number">
                                    <Path />
                                </Button>
                            </TextBox.InnerRightContent>
                        </TextBox>
                        <TextBlock Grid.Row="0" Grid.Column="3" Classes="unit" Text="=" TextAlignment="Center"
                                   VerticalAlignment="Center" />
                        <TextBox Grid.Row="0" Grid.Column="4" x:Name="ServingCaloriesBox" Classes="numeric"
                                 Text="{Binding Portion.ServingCaloriesText}">
                            <TextBox.InnerRightContent>
                                <Button Classes="copyIcon" Click="OnCopyIconClick" ToolTip.Tip="Copy this number">
                                    <Path />
                                </Button>
                            </TextBox.InnerRightContent>
                        </TextBox>
                        <TextBlock Grid.Row="0" Grid.Column="5" Classes="unit" Text="cal" Margin="6,0,0,0" />

                        <!-- The density readout, compact, in the serving row. -->
                        <Border Grid.Row="0" Grid.Column="6" x:Name="DensityChip" Classes="heroChip"
                                Classes.placeholder="{Binding Portion.DensityIsPlaceholder}"
                                HorizontalAlignment="Right" VerticalAlignment="Center" Margin="16,0,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                <TextBlock x:Name="DensityHero" Classes="hero"
                                           Classes.placeholder="{Binding Portion.DensityIsPlaceholder}"
                                           Text="{Binding Portion.DensityCalPerG}"
                                           FontSize="19" FontFeatures="+tnum" VerticalAlignment="Center" />
                                <TextBlock Classes="heroUnit" Text="cal/g" VerticalAlignment="Center" />
                                <TextBlock Classes="heroUnit" VerticalAlignment="Center"
                                           Text="{Binding Portion.DensityPer100, StringFormat='· {0} / 100 g'}" />
                            </StackPanel>
                        </Border>

                        <TextBlock Grid.Row="2" Grid.Column="0" Classes="fieldLabel" Text="Eaten" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Classes="unit" Text="grams" Margin="0,0,8,0"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                        <TextBox Grid.Row="2" Grid.Column="2" x:Name="EatenGramsBox" Classes="numeric"
                                 Classes.computed="{Binding Portion.EatenGramsIsComputed}"
                                 Text="{Binding Portion.EatenGramsText}">
                            <TextBox.InnerRightContent>
                                <Button Classes="copyIcon" Click="OnCopyIconClick" ToolTip.Tip="Copy this number">
                                    <Path />
                                </Button>
                            </TextBox.InnerRightContent>
                        </TextBox>
                        <TextBlock Grid.Row="2" Grid.Column="3" Classes="unit" Text="⇄" TextAlignment="Center"
                                   VerticalAlignment="Center" />
                        <TextBox Grid.Row="2" Grid.Column="4" x:Name="EatenCaloriesBox" Classes="numeric"
                                 Classes.computed="{Binding Portion.EatenCaloriesIsComputed}"
                                 Text="{Binding Portion.EatenCaloriesText}">
                            <TextBox.InnerRightContent>
                                <Button Classes="copyIcon" Click="OnCopyIconClick" ToolTip.Tip="Copy this number">
                                    <Path />
                                </Button>
                            </TextBox.InnerRightContent>
                        </TextBox>
                        <TextBlock Grid.Row="2" Grid.Column="5" Classes="unit" Text="cal" Margin="6,0,0,0" />
                        <Button Grid.Row="2" Grid.Column="6" x:Name="UseDishNetButton" Classes="quiet"
                                HorizontalAlignment="Right" Margin="16,0,0,0"
                                MaxWidth="180" Content="{Binding UseDishNetLabel}"
                                IsEnabled="{Binding CanUseDishNet}"
                                ToolTip.Tip="Copy the dish row's net weight into eaten grams"
                                Click="OnUseDishNetClick" />
                    </Grid>
                </Grid>
                </Border>
            </Panel>
        </Border>

        <!-- SCALE card -->
        <Border Classes="card">
            <Panel>
                <Border Classes="cardGloss" />
                <Border Classes="cardHighlight" />
                <Border Classes="cardContent">
                <Grid ColumnDefinitions="Auto,*">
                    <StackPanel Classes="sectionLabel">
                        <Path Classes="sectionMark" HorizontalAlignment="Center" />
                        <LayoutTransformControl HorizontalAlignment="Center">
                            <LayoutTransformControl.LayoutTransform>
                                <RotateTransform Angle="-90" />
                            </LayoutTransformControl.LayoutTransform>
                            <TextBlock Classes="sectionTitle" Text="SCALE" />
                        </LayoutTransformControl>
                    </StackPanel>

                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                    <!-- The MinHeight binding lets the flex band absorb surplus
                         card height at tall sizes while the ScrollViewer still
                         guards short windows. -->
                    <Grid RowDefinitions="Auto,*"
                          MinHeight="{Binding $parent[ScrollViewer].Viewport.Height}">
                    <Grid Grid.Row="0" ColumnDefinitions="*,24,Auto" RowDefinitions="Auto,Auto">

                    <!-- Cookware rows on one shared grid: stars, names, tare
                         echoes, and both field columns all align. -->
                    <StackPanel Grid.Row="0" Grid.Column="0">
                        <Grid ColumnDefinitions="8,24,140,56,104,24,104,18,*" Margin="0,0,0,3">
                            <TextBlock Grid.Column="4" x:Name="WithCookwareHeader" Classes="columnHeader"
                                       Text="WITH COOKWARE" />
                            <TextBlock Grid.Column="6" x:Name="FoodOnlyHeader" Classes="columnHeader"
                                       Text="FOOD ONLY" />
                        </Grid>

                        <ItemsControl x:Name="CookwareRowsControl" ItemsSource="{Binding Scale.Rows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="core:CookwareRowModel">
                                    <Grid Classes="cookwareRow" Classes.dish="{Binding IsDish}" Classes.dim="{Binding IsEmpty}"
                                          ColumnDefinitions="8,24,140,56,104,24,104,18,*">
                                        <Border Grid.Column="0" Classes="dishBar" IsVisible="{Binding IsDish}" />
                                        <Button Grid.Column="1" Classes="star" Classes.pinned="{Binding Pinned}"
                                                IsVisible="{Binding !IsNoCookware}" Click="OnStarClick"
                                                ToolTip.Tip="Pin or unpin this cookware">
                                            <Panel>
                                                <TextBlock Text="★" IsVisible="{Binding Pinned}" />
                                                <TextBlock Text="☆" IsVisible="{Binding !Pinned}" />
                                            </Panel>
                                        </Button>
                                        <TextBlock Grid.Column="2" Classes="cookwareName" Text="{Binding Name}"
                                                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}"
                                                   Margin="2,0,8,0" />
                                        <TextBlock Grid.Column="3" Classes="unit" FontSize="11" Text="{Binding TareEcho}"
                                                   Margin="0,0,8,0" />
                                        <TextBox Grid.Column="4" Classes="numeric rowGross"
                                                 Classes.computed="{Binding GrossIsComputed}"
                                                 Text="{Binding GrossText}"
                                                 views:Pulse.Tick="{Binding ComputedPulse}">
                                            <TextBox.InnerRightContent>
                                                <Button Classes="copyIcon" Click="OnCopyIconClick" ToolTip.Tip="Copy this number">
                                                    <Path />
                                                </Button>
                                            </TextBox.InnerRightContent>
                                        </TextBox>
                                        <TextBlock Grid.Column="5" Classes="unit" Text="⇄" TextAlignment="Center"
                                                   VerticalAlignment="Center" IsVisible="{Binding !IsNoCookware}" />
                                        <TextBlock Grid.Column="5" Classes="unit" Text="g" Margin="6,0,0,0"
                                                   VerticalAlignment="Center" IsVisible="{Binding IsNoCookware}" />
                                        <TextBox Grid.Column="6" Classes="numeric rowNet"
                                                 Classes.computed="{Binding NetIsComputed}"
                                                 Classes.warn="{Binding BelowTare}"
                                                 Text="{Binding NetText}"
                                                 views:Pulse.Tick="{Binding ComputedPulse}"
                                                 IsVisible="{Binding !IsNoCookware}">
                                            <TextBox.InnerRightContent>
                                                <Button Classes="copyIcon" Click="OnCopyIconClick" ToolTip.Tip="Copy this number">
                                                    <Path />
                                                </Button>
                                            </TextBox.InnerRightContent>
                                        </TextBox>
                                        <TextBlock Grid.Column="7" Classes="unit" Text="g" Margin="4,0,0,0"
                                                   VerticalAlignment="Center" IsVisible="{Binding !IsNoCookware}" />
                                        <TextBlock Grid.Column="8" Classes="belowTare" Margin="8,0,0,0"
                                                   Text="below tare, wrong cookware?"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip.Tip="below tare, wrong cookware?"
                                                   IsVisible="{Binding BelowTare}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel IsVisible="{Binding MoreCookwareVisible}" Margin="26,2,0,0">
                            <Button x:Name="MoreCookwareToggle" Classes="linklike" Click="OnMoreCookwareToggleClick"
                                    ToolTip.Tip="Rarely used cookware (Alt+M)">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="▸" FontSize="10" VerticalAlignment="Center"
                                               IsVisible="{Binding !MoreCookwareOpen}" />
                                    <TextBlock Text="▾" FontSize="10" VerticalAlignment="Center"
                                               IsVisible="{Binding MoreCookwareOpen}" />
                                    <TextBlock Text="{Binding MoreCookwareHeader}" />
                                </StackPanel>
                            </Button>
                            <ListBox x:Name="MoreCookwareList" Classes="logList" ItemsSource="{Binding Scale.AvailableCookware}"
                                     IsVisible="{Binding MoreCookwareOpen}" Margin="16,2,0,0"
                                     IsTabStop="False" KeyboardNavigation.TabNavigation="None"
                                     Tapped="OnMoreCookwareTapped" KeyDown="OnMoreCookwareKeyDown">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="core:Cookware">
                                        <StackPanel Orientation="Horizontal" Spacing="10" Height="24">
                                            <TextBlock Foreground="{DynamicResource InkBrush}" Text="{Binding Name}"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Classes="unit" FontSize="11" VerticalAlignment="Center"
                                                       Text="{Binding Grams, StringFormat='tare {0} g'}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </StackPanel>

                    <!-- Divider between the rows and the water column. -->
                    <Border Grid.Row="0" Grid.Column="1" x:Name="WaterDivider" Width="1"
                            Background="{DynamicResource ShelfRuleBrush}" Margin="11,4,12,4"
                            HorizontalAlignment="Center" IsHitTestVisible="False" />

                    <!-- Water section: dish caption, recipe weight, delta. -->
                    <StackPanel x:Name="WaterColumn" Spacing="8" Width="278">
                        <TextBlock x:Name="DishCaptionText" Classes="dishCaption pulseable"
                                   Text="{Binding Scale.DishCaption}" Margin="2,0,0,2"
                                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Scale.DishCaption}" />
                        <Grid ColumnDefinitions="*,Auto,18">
                            <TextBlock Grid.Column="0" Classes="fieldLabel" Text="Recipe weight" Margin="2,0,10,0" />
                            <TextBox Grid.Column="1" x:Name="RecipeBox" Classes="numeric"
                                     HorizontalAlignment="Right"
                                     Text="{Binding Scale.RecipeText}">
                                <TextBox.InnerRightContent>
                                    <Button Classes="copyIcon" Click="OnCopyIconClick" ToolTip.Tip="Copy this number">
                                        <Path />
                                    </Button>
                                </TextBox.InnerRightContent>
                            </TextBox>
                            <TextBlock Grid.Column="2" Classes="unit" Text="g" Margin="4,0,0,0" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto,18">
                            <TextBlock Grid.Column="0" Classes="fieldLabel" Text="Water to add" Margin="2,0,10,0" />
                            <TextBox Grid.Column="1" x:Name="DeltaBox" Classes="numeric computed delta"
                                     IsReadOnly="True" Text="{Binding Scale.DeltaText, Mode=OneWay}"
                                     views:Pulse.Tick="{Binding Scale.DeltaPulse}">
                                <TextBox.InnerRightContent>
                                    <Button x:Name="DeltaCopyButton" Classes="copyIcon"
                                            Click="OnDeltaCopyIconClick"
                                            ToolTip.Tip="Copy the bare signed number (Enter in the recipe field also copies)">
                                        <Path />
                                    </Button>
                                </TextBox.InnerRightContent>
                            </TextBox>
                            <TextBlock Grid.Column="2" Classes="unit" Text="g" Margin="4,0,0,0" />
                        </Grid>
                        <!-- At tall sizes some themes reflect the delta on the
                             surface beneath it. -->
                        <Grid ColumnDefinitions="*,Auto,18">
                            <Border Grid.Column="1" x:Name="DeltaReflection" Height="10" Width="150"
                                    CornerRadius="10" IsHitTestVisible="False" />
                        </Grid>
                    </StackPanel>
                    </Grid>

                    <!-- Flex band: absorbs surplus card height at tall sizes. -->
                    <Border Grid.Row="1" x:Name="ScaleFlexBand" IsHitTestVisible="False" MinHeight="0" />
                    </Grid>
                    </ScrollViewer>
                </Grid>
                </Border>
            </Panel>
        </Border>
        </DockPanel>

        <!-- The log view, on demand: floats over the work area, closed with
             the Log button, its Close button, or Esc. -->
        <Border x:Name="LogOverlay" Classes="card recessed logOverlay" IsVisible="{Binding LogDrawerOpen}">
            <Panel>
                <Border Classes="cardGloss" />
                <Border Classes="cardHighlight" />
                <DockPanel Margin="20,12,20,12">
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Path Classes="sectionMark" />
                            <TextBlock Classes="sectionTitle" Text="LOG" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Classes="unit" FontSize="11" VerticalAlignment="Center"
                                   Margin="0,0,12,0" Text="click a row to copy its result" />
                        <Button Grid.Column="3" x:Name="LogCloseButton" Classes="quiet" Content="Close"
                                Padding="12,2" MinHeight="26" ToolTip.Tip="Close the log (Esc)"
                                Click="OnLogClick" />
                    </Grid>
                    <ScrollViewer>
                        <ListBox x:Name="DrawerLogList" Classes="logList" ItemsSource="{Binding Log.Drawer}"
                                 IsTabStop="False" KeyboardNavigation.TabNavigation="None"
                                 Tapped="OnLogListTapped" KeyDown="OnLogListKeyDown">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:LogRow">
                                    <Grid ColumnDefinitions="140,86,72,*">
                                        <TextBlock Grid.Column="0" Classes="unit" FontFeatures="+tnum" Text="{Binding Time}" />
                                        <TextBlock Grid.Column="1" Classes="logResult"
                                                   FontFeatures="+tnum" Text="{Binding Result}" Margin="0,0,12,0" />
                                        <Border Grid.Column="2" Classes="tagPill">
                                            <TextBlock Text="{Binding Kind}" />
                                        </Border>
                                        <TextBlock Grid.Column="3" Classes="logEquation"
                                                   Text="{Binding Equation}" TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>
                </DockPanel>
            </Panel>
        </Border>
        </Panel>

        <!-- Status bar -->
        <Border Grid.Row="1" Classes="statusBar" Margin="0,8,0,0">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <SelectableTextBlock Grid.Column="0" x:Name="StatusLineText" Classes="statusEcho"
                                     Text="{Binding StatusLine}" VerticalAlignment="Center"
                                     TextTrimming="CharacterEllipsis" ToolTip.Tip="Click to copy this result"
                                     Tapped="OnStatusLineTapped" />
                <TextBlock Grid.Column="1" Classes="notice" FontSize="13" VerticalAlignment="Center"
                           Margin="12,0" Classes.warnNotice="{Binding StatusNoticeIsWarning}"
                           Text="{Binding StatusNotice}" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Button x:Name="ResetButton" Classes="quiet icon"
                            ToolTip.Tip="Reset: clear all entered numbers (Ctrl+R)" Click="OnResetClick">
                        <Path Data="{StaticResource ResetIconGeometry}" />
                    </Button>
                    <Button x:Name="LogButton" Classes="quiet icon"
                            ToolTip.Tip="Show the calculation log (Ctrl+L)" Click="OnLogClick">
                        <Path Data="{StaticResource LogIconGeometry}" />
                    </Button>
                    <Button x:Name="GearButton" Classes="quiet icon"
                            ToolTip.Tip="Cookware and theme settings" Click="OnGearClick">
                        <Path Data="{StaticResource GearIconGeometry}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
        </Grid>
    </Panel>
</Window>
