<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ZFood.App.ViewModels"
        xmlns:core="using:ZFood.Core"
        xmlns:views="using:ZFood.App.Views"
        x:Class="ZFood.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="ZFood"
        Icon="/Assets/zfood.png"
        Width="880" Height="920"
        MinWidth="720" MinHeight="700"
        Background="{StaticResource PorcelainBrush}">

    <Window.Styles>
        <!-- The teal marker bar carried by the dish row alone. -->
        <Style Selector="Border.dishBar">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Width" Value="4" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Margin" Value="0,6" />
        </Style>

        <!-- Pot rows: empty rows are dim ghosts, the dish row is emphasized. -->
        <Style Selector="Grid.potRow.dim">
            <Setter Property="Opacity" Value="0.5" />
        </Style>
        <Style Selector="Grid.potRow.dish">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Grid.potRow.dish TextBlock.potName">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.potName">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Pulse-capable text readouts (the density hero). -->
        <Style Selector="TextBlock.pulseable">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="TextBlock.pulseable.pulse">
            <Setter Property="Background" Value="{StaticResource PulseTintBrush}" />
        </Style>
        <Style Selector="TextBlock.hero">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        </Style>
        <Style Selector="TextBlock.hero.placeholder">
            <Setter Property="Foreground" Value="{StaticResource GhostBrush}" />
        </Style>

        <!-- Below-tare hint. -->
        <Style Selector="TextBlock.belowTare">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource WarnBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Pin stars: pure glyph buttons outside the tab order. -->
        <Style Selector="Button.star">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="MinWidth" Value="34" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="{StaticResource GhostBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.star.pinned">
            <Setter Property="Foreground" Value="{StaticResource SubtleBrush}" />
        </Style>

        <!-- The dish caption in the water section. -->
        <Style Selector="TextBlock.dishCaption">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        </Style>

        <!-- Log rows. -->
        <Style Selector="ListBox.logList">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="ListBox.logList ListBoxItem">
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="MinHeight" Value="26" />
        </Style>
        <Style Selector="TextBlock.logDay">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="LetterSpacing" Value="1.6" />
            <Setter Property="Foreground" Value="{StaticResource SubtleBrush}" />
            <Setter Property="Margin" Value="0,8,0,2" />
        </Style>

        <!-- Status bar notices. -->
        <Style Selector="TextBlock.notice">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        </Style>
        <Style Selector="TextBlock.notice.warnNotice">
            <Setter Property="Foreground" Value="{StaticResource WarnBrush}" />
        </Style>
    </Window.Styles>

    <DockPanel Margin="18,14,18,10">

        <!-- Header -->
        <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto,Auto,Auto" Margin="2,0,2,12">
            <TextBlock Grid.Column="0" Text="ZFood" FontSize="18" FontWeight="SemiBold"
                       Foreground="{StaticResource InkBrush}" VerticalAlignment="Center" />
            <Button Grid.Column="2" x:Name="ResetButton" Classes="quiet" Content="Reset"
                    ToolTip.Tip="Clear all entered numbers (Ctrl+R)" Margin="0,0,8,0" Click="OnResetClick" />
            <Button Grid.Column="3" x:Name="LogButton" Classes="quiet" Content="Log"
                    ToolTip.Tip="Show the calculation log (Ctrl+L)" Margin="0,0,8,0" Click="OnLogClick" />
            <Button Grid.Column="4" x:Name="GearButton" Classes="quiet" Content="⚙"
                    FontSize="15" Padding="10,4" ToolTip.Tip="Cookware settings" Click="OnGearClick" />
        </Grid>

        <!-- Status bar -->
        <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,10,Auto,*,Auto" Margin="4,8,4,0">
            <TextBlock Grid.Column="0" Text="{Binding StatusEcho}" FontSize="13" FontWeight="Medium"
                       Foreground="{StaticResource AccentBrush}" />
            <TextBlock Grid.Column="2" Classes="unit" Text="{Binding StatusTime}" />
            <TextBlock Grid.Column="4" Classes="notice" FontSize="13"
                       Classes.warnNotice="{Binding StatusNoticeIsWarning}"
                       Text="{Binding StatusNotice}" />
        </Grid>

        <!-- LOG card -->
        <Border DockPanel.Dock="Bottom" Classes="card" Margin="0,12,0,0" Padding="20,12,20,10">
            <StackPanel>
                <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,4">
                    <TextBlock Classes="sectionTitle" Text="LOG" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Classes="unit" FontSize="11"
                               Text="click a row to copy its result" />
                </Grid>
                <ListBox x:Name="RecentLogList" Classes="logList" IsVisible="{Binding !LogDrawerOpen}"
                         ItemsSource="{Binding Log.Recent}" Height="82"
                         Tapped="OnLogListTapped" KeyDown="OnLogListKeyDown">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:LogRow">
                            <Grid ColumnDefinitions="44,86,66,*">
                                <TextBlock Grid.Column="0" Classes="unit" Text="{Binding Time}" />
                                <TextBlock Grid.Column="1" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"
                                           FontFeatures="+tnum" Text="{Binding Result}" Margin="0,0,12,0"
                                           TextAlignment="Right" />
                                <TextBlock Grid.Column="2" Classes="unit" FontSize="11" Text="{Binding Kind}" />
                                <TextBlock Grid.Column="3" FontSize="13" Foreground="{StaticResource SubtleBrush}"
                                           Text="{Binding Equation}" TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Border IsVisible="{Binding LogDrawerOpen}" Height="208">
                    <ScrollViewer>
                        <ListBox x:Name="DrawerLogList" Classes="logList" ItemsSource="{Binding Log.Drawer}"
                                 Tapped="OnLogListTapped" KeyDown="OnLogListKeyDown">
                            <ListBox.DataTemplates>
                                <DataTemplate DataType="vm:LogDayHeader">
                                    <TextBlock Classes="logDay" Text="{Binding Label}" />
                                </DataTemplate>
                                <DataTemplate DataType="vm:LogRow">
                                    <Grid ColumnDefinitions="44,86,66,*">
                                        <TextBlock Grid.Column="0" Classes="unit" Text="{Binding Time}" />
                                        <TextBlock Grid.Column="1" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"
                                                   FontFeatures="+tnum" Text="{Binding Result}" Margin="0,0,12,0"
                                                   TextAlignment="Right" />
                                        <TextBlock Grid.Column="2" Classes="unit" FontSize="11" Text="{Binding Kind}" />
                                        <TextBlock Grid.Column="3" FontSize="13" Foreground="{StaticResource SubtleBrush}"
                                                   Text="{Binding Equation}" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.DataTemplates>
                        </ListBox>
                    </ScrollViewer>
                </Border>
            </StackPanel>
        </Border>

        <!-- PORTION card -->
        <Border DockPanel.Dock="Top" Classes="card" Margin="0,0,0,12">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="10">
                    <TextBlock Classes="sectionTitle" Text="PORTION" />
                    <!-- Columns mirror the pot rows below so every numeral sits
                         on one shared grid across both cards. -->
                    <Grid x:Name="PortionPanel" ColumnDefinitions="186,52,Auto,24,Auto,26,Auto"
                          RowDefinitions="Auto,10,Auto">
                        <TextBlock Grid.Row="0" Grid.Column="0" Classes="fieldLabel" Text="Serving" Margin="6,0,0,0" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Classes="unit" Text="grams" Margin="0,0,8,0"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                        <TextBox Grid.Row="0" Grid.Column="2" x:Name="ServingGramsBox" Classes="numeric"
                                 Text="{Binding Portion.ServingGramsText}" TabIndex="1" />
                        <TextBlock Grid.Row="0" Grid.Column="3" Classes="unit" Text="=" TextAlignment="Center"
                                   VerticalAlignment="Center" />
                        <TextBox Grid.Row="0" Grid.Column="4" x:Name="ServingCaloriesBox" Classes="numeric"
                                 Text="{Binding Portion.ServingCaloriesText}" TabIndex="2" />
                        <TextBlock Grid.Row="0" Grid.Column="5" Classes="unit" Text="cal" Margin="6,0,0,0" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Classes="fieldLabel" Text="Eaten" Margin="6,0,0,0" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Classes="unit" Text="grams" Margin="0,0,8,0"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                        <TextBox Grid.Row="2" Grid.Column="2" x:Name="EatenGramsBox" Classes="numeric"
                                 Classes.computed="{Binding Portion.EatenGramsIsComputed}"
                                 Text="{Binding Portion.EatenGramsText}" TabIndex="3" />
                        <TextBlock Grid.Row="2" Grid.Column="3" Classes="unit" Text="⇄" TextAlignment="Center"
                                   VerticalAlignment="Center" />
                        <TextBox Grid.Row="2" Grid.Column="4" x:Name="EatenCaloriesBox" Classes="numeric"
                                 Classes.computed="{Binding Portion.EatenCaloriesIsComputed}"
                                 Text="{Binding Portion.EatenCaloriesText}" TabIndex="4" />
                        <TextBlock Grid.Row="2" Grid.Column="5" Classes="unit" Text="cal" Margin="6,0,0,0" />
                        <Button Grid.Row="2" Grid.Column="6" x:Name="UseDishNetButton" Classes="quiet"
                                Margin="16,0,0,0" Content="{Binding UseDishNetLabel}"
                                IsEnabled="{Binding CanUseDishNet}"
                                ToolTip.Tip="Copy the dish row's net weight into eaten grams"
                                Click="OnUseDishNetClick" />
                    </Grid>
                </StackPanel>

                <!-- Density hero: the instrument's main display. -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="0">
                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                        <TextBlock x:Name="DensityHero" Classes="pulseable hero"
                                   Classes.placeholder="{Binding Portion.DensityIsPlaceholder}"
                                   Text="{Binding Portion.DensityCalPerG}"
                                   FontSize="46" FontWeight="Light" FontFeatures="+tnum" />
                        <TextBlock Classes="unit" Text="cal/g" VerticalAlignment="Bottom" Margin="0,0,0,9" />
                    </StackPanel>
                    <TextBlock HorizontalAlignment="Right" Classes="unit"
                               Text="{Binding Portion.DensityPer100, StringFormat='{}{0} cal / 100 g'}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- SCALE card -->
        <Border Classes="card">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Classes="sectionTitle" Text="SCALE" Margin="0,0,0,10" />

                    <!-- Pot rows -->
                    <ItemsControl x:Name="PotRowsControl" ItemsSource="{Binding Scale.Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="core:PotRowModel">
                                <Grid Classes="potRow" Classes.dish="{Binding IsDish}" Classes.dim="{Binding IsEmpty}"
                                      ColumnDefinitions="8,178,52,Auto,24,Auto,26,Auto,*,36" Height="38"
                                      Background="Transparent">
                                    <Border Grid.Column="0" Classes="dishBar" IsVisible="{Binding IsDish}" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                                                VerticalAlignment="Center" Margin="6,0,0,0">
                                        <TextBlock Classes="potName" Text="{Binding Name}" />
                                        <TextBlock Classes="unit" FontSize="11" Text="{Binding TareEcho}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Classes="unit" Text="reads" Margin="0,0,8,0"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"
                                               IsVisible="{Binding !IsNoPot}" />
                                    <TextBlock Grid.Column="2" Classes="unit" Text="weight" Margin="0,0,8,0"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"
                                               IsVisible="{Binding IsNoPot}" />
                                    <TextBox Grid.Column="3" Classes="numeric rowGross"
                                             Classes.computed="{Binding GrossIsComputed}"
                                             Text="{Binding GrossText}"
                                             views:Pulse.Tick="{Binding ComputedPulse}" />
                                    <TextBlock Grid.Column="4" Classes="unit" Text="⇄" TextAlignment="Center"
                                               VerticalAlignment="Center" IsVisible="{Binding !IsNoPot}" />
                                    <TextBox Grid.Column="5" Classes="numeric rowNet"
                                             Classes.computed="{Binding NetIsComputed}"
                                             Classes.warn="{Binding BelowTare}"
                                             Text="{Binding NetText}"
                                             views:Pulse.Tick="{Binding ComputedPulse}"
                                             IsVisible="{Binding !IsNoPot}" />
                                    <TextBlock Grid.Column="6" Classes="unit" Text="g" Margin="6,0,0,0"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="7" Classes="belowTare" Margin="10,0,0,0"
                                               Text="below tare, wrong pot?" IsVisible="{Binding BelowTare}" />
                                    <Button Grid.Column="9" Classes="star" Classes.pinned="{Binding Pinned}"
                                            IsVisible="{Binding !IsNoPot}" Click="OnStarClick"
                                            ToolTip.Tip="Pin or unpin this pot">
                                        <Panel>
                                            <TextBlock Text="★" IsVisible="{Binding Pinned}" />
                                            <TextBlock Text="☆" IsVisible="{Binding !Pinned}" />
                                        </Panel>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel IsVisible="{Binding MorePotsVisible}" Margin="8,4,0,0">
                        <Button x:Name="MorePotsToggle" Classes="linklike" Click="OnMorePotsToggleClick"
                                ToolTip.Tip="Rarely used cookware (Alt+M)">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="▸" FontSize="10" VerticalAlignment="Center"
                                           IsVisible="{Binding !MorePotsOpen}" />
                                <TextBlock Text="▾" FontSize="10" VerticalAlignment="Center"
                                           IsVisible="{Binding MorePotsOpen}" />
                                <TextBlock Text="{Binding MorePotsHeader}" />
                            </StackPanel>
                        </Button>
                        <ListBox x:Name="MorePotsList" Classes="logList" ItemsSource="{Binding Scale.AvailablePots}"
                                 IsVisible="{Binding MorePotsOpen}" Margin="16,2,0,0"
                                 Tapped="OnMorePotsTapped" KeyDown="OnMorePotsKeyDown">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="core:Cookware">
                                    <StackPanel Orientation="Horizontal" Spacing="10" Height="24">
                                        <TextBlock Foreground="{StaticResource InkBrush}" Text="{Binding Name}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Classes="unit" FontSize="11" VerticalAlignment="Center"
                                                   Text="{Binding Grams, StringFormat='tare {0} g'}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>

                    <!-- Water section -->
                    <Border Classes="hairline" Margin="0,10,0,10" />
                    <TextBlock x:Name="DishCaptionText" Classes="dishCaption pulseable"
                               Text="{Binding Scale.DishCaption}" Margin="8,0,0,10" />
                    <!-- The 238 px label column lines the water boxes up with the
                         pot rows' reads column; the delta's right edge meets the
                         net column's right edge. -->
                    <Grid ColumnDefinitions="238,232,28,Auto" RowDefinitions="Auto,10,Auto">
                        <TextBlock Grid.Row="0" Grid.Column="0" Classes="fieldLabel" Text="Recipe weight" Margin="8,0,0,0" />
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="RecipeBox" Classes="numeric"
                                 HorizontalAlignment="Right"
                                 Text="{Binding Scale.RecipeText}" TabIndex="40" />
                        <TextBlock Grid.Row="0" Grid.Column="2" Classes="unit" Text="g" Margin="6,0,0,0" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Classes="fieldLabel" Text="Water to add" Margin="8,0,0,0" />
                        <TextBox Grid.Row="2" Grid.Column="1" x:Name="DeltaBox" Classes="numeric computed delta"
                                 IsReadOnly="True" Text="{Binding Scale.DeltaText, Mode=OneWay}"
                                 views:Pulse.Tick="{Binding Scale.DeltaPulse}" TabIndex="41" />
                        <TextBlock Grid.Row="2" Grid.Column="2" Classes="unit" Text="g" Margin="6,0,0,0" />
                        <Button Grid.Row="2" Grid.Column="3" x:Name="CopyButton" Classes="quiet" Content="Copy"
                                Margin="16,0,0,0" VerticalAlignment="Center" IsEnabled="{Binding Scale.CanCopy}"
                                ToolTip.Tip="Copy the bare signed number (Enter in the recipe field also copies)"
                                Click="OnCopyClick" />
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </DockPanel>
</Window>
