<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ZFood.App.App"
             RequestedThemeVariant="Light">
    <!-- The light variant is forced: the porcelain-and-teal look must not
         invert or mix with the system theme. -->

    <Application.Resources>
        <!-- The one accent everywhere, including toolkit-drawn selection and
             focus chrome: deep teal, never the stock blue. -->
        <Color x:Key="SystemAccentColor">#0E7568</Color>
        <Color x:Key="SystemAccentColorDark1">#0C6459</Color>
        <Color x:Key="SystemAccentColorDark2">#0A534A</Color>
        <Color x:Key="SystemAccentColorDark3">#08423B</Color>
        <Color x:Key="SystemAccentColorLight1">#2A8578</Color>
        <Color x:Key="SystemAccentColorLight2">#469589</Color>
        <Color x:Key="SystemAccentColorLight3">#62A59A</Color>

        <!-- Instrument palette -->
        <Color x:Key="PorcelainColor">#F2F3F5</Color>
        <Color x:Key="CardColor">#FFFFFF</Color>
        <Color x:Key="HairlineColor">#E3E5E8</Color>
        <Color x:Key="HairlineStrongColor">#D3D7DC</Color>
        <Color x:Key="InkColor">#1B1F24</Color>
        <Color x:Key="SubtleColor">#4B5563</Color>
        <Color x:Key="GhostColor">#7E8794</Color>
        <Color x:Key="AccentColor">#0E7568</Color>
        <Color x:Key="AccentTintColor">#EDF4F2</Color>
        <Color x:Key="PulseTintColor">#C5E0DB</Color>
        <Color x:Key="WarnColor">#8F6A12</Color>
        <Color x:Key="ErrorColor">#A42B1D</Color>

        <SolidColorBrush x:Key="PorcelainBrush" Color="{StaticResource PorcelainColor}" />
        <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}" />
        <SolidColorBrush x:Key="HairlineBrush" Color="{StaticResource HairlineColor}" />
        <SolidColorBrush x:Key="HairlineStrongBrush" Color="{StaticResource HairlineStrongColor}" />
        <SolidColorBrush x:Key="InkBrush" Color="{StaticResource InkColor}" />
        <SolidColorBrush x:Key="SubtleBrush" Color="{StaticResource SubtleColor}" />
        <SolidColorBrush x:Key="GhostBrush" Color="{StaticResource GhostColor}" />
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
        <SolidColorBrush x:Key="AccentTintBrush" Color="{StaticResource AccentTintColor}" />
        <SolidColorBrush x:Key="PulseTintBrush" Color="{StaticResource PulseTintColor}" />
        <SolidColorBrush x:Key="WarnBrush" Color="{StaticResource WarnColor}" />
        <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}" />
        <SolidColorBrush x:Key="SelectionBrush" Color="#3D0E7568" />

        <!-- Copy glyph: two overlapping sheets, drawn as a stroked vector path
             (used by the in-field copy icons on computed values). -->
        <StreamGeometry x:Key="CopyIconGeometry">M11 9 H19 A2 2 0 0 1 21 11 V19 A2 2 0 0 1 19 21 H11 A2 2 0 0 1 9 19 V11 A2 2 0 0 1 11 9 Z M5 15 H4 A2 2 0 0 1 2 13 V4 A2 2 0 0 1 4 2 H13 A2 2 0 0 1 15 4 V5</StreamGeometry>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <!-- Panels are white cards floating on porcelain. -->
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="20,14" />
            <Setter Property="BoxShadow" Value="0 2 10 0 #10141A14" />
        </Style>

        <!-- Every text box: quiet hairline field, teal ring when focused. -->
        <Style Selector="TextBox">
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource HairlineStrongBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="SelectionBrush" Value="{StaticResource SelectionBrush}" />
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
        </Style>
        <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{StaticResource SubtleBrush}" />
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
        </Style>

        <!-- List rows stay quiet: faint teal selection, no stock blue. -->
        <Style Selector="ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AccentTintBrush}" />
        </Style>
        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource PorcelainBrush}" />
        </Style>
        <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AccentTintBrush}" />
        </Style>

        <!-- Numeric entry boxes: mid-size calm tabular digits, right-aligned. -->
        <Style Selector="TextBox.numeric">
            <Setter Property="HorizontalContentAlignment" Value="Right" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontFeatures" Value="+tnum" />
            <Setter Property="Width" Value="104" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="10,6" />
        </Style>

        <!-- Computed member of a pair: faint teal tint, teal digits, real box. -->
        <Style Selector="TextBox.numeric.computed">
            <Setter Property="Background" Value="{StaticResource AccentTintBrush}" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="TextBox.numeric.computed:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{StaticResource AccentTintBrush}" />
        </Style>
        <Style Selector="TextBox.numeric.computed.pulse">
            <Setter Property="Background" Value="{StaticResource PulseTintBrush}" />
        </Style>

        <!-- Field in a warning state (gross below tare). -->
        <Style Selector="TextBox.numeric.warn">
            <Setter Property="Foreground" Value="{StaticResource WarnBrush}" />
        </Style>

        <!-- The water delta: a hero readout like the display of a fine scale.
             Still a real selectable text box. -->
        <Style Selector="TextBox.numeric.delta">
            <Setter Property="FontSize" Value="32" />
            <Setter Property="FontWeight" Value="Light" />
            <Setter Property="Width" Value="232" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="Padding" Value="10,2" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <!-- Section titles: small letterspaced uppercase micro-labels. -->
        <Style Selector="TextBlock.sectionTitle">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="LetterSpacing" Value="2.2" />
            <Setter Property="Foreground" Value="{StaticResource SubtleBrush}" />
        </Style>

        <!-- Field labels: calm primary ink. -->
        <Style Selector="TextBlock.fieldLabel">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Unit labels sit outside the boxes, secondary. -->
        <Style Selector="TextBlock.unit">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource SubtleBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Quiet buttons; kept out of the tab cycle so Tab walks fields. -->
        <Style Selector="Button.quiet">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource HairlineStrongBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Button.quiet:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource PorcelainBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource SubtleBrush}" />
        </Style>
        <Style Selector="Button.quiet:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource HairlineBrush}" />
        </Style>
        <Style Selector="Button.quiet:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource PorcelainBrush}" />
            <Setter Property="TextElement.Foreground" Value="{StaticResource GhostBrush}" />
        </Style>

        <!-- Quiet text-only toggle (the More-cookware expander header). -->
        <Style Selector="Button.linklike">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource SubtleBrush}" />
        </Style>
        <Style Selector="Button.linklike:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource PorcelainBrush}" />
        </Style>

        <!-- In-field copy icons: quiet inside the box's right edge, teal on
             hover and while the field has focus. -->
        <Style Selector="Button.copyIcon">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="5,0" />
            <Setter Property="MinWidth" Value="26" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.copyIcon:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.copyIcon:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.copyIcon Path">
            <Setter Property="Data" Value="{StaticResource CopyIconGeometry}" />
            <Setter Property="Width" Value="13" />
            <Setter Property="Height" Value="13" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Stroke" Value="{StaticResource GhostBrush}" />
            <Setter Property="StrokeThickness" Value="2" />
            <Setter Property="StrokeJoin" Value="Round" />
            <Setter Property="StrokeLineCap" Value="Round" />
        </Style>
        <Style Selector="Button.copyIcon:pointerover Path">
            <Setter Property="Stroke" Value="{StaticResource AccentBrush}" />
        </Style>
        <Style Selector="TextBox:focus-within Button.copyIcon Path">
            <Setter Property="Stroke" Value="{StaticResource AccentBrush}" />
        </Style>
        <Style Selector="Button.copyIcon:disabled Path">
            <Setter Property="Stroke" Value="{StaticResource HairlineStrongBrush}" />
        </Style>

        <!-- Hairline separators. -->
        <Style Selector="Border.hairline">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{StaticResource HairlineBrush}" />
        </Style>
    </Application.Styles>
</Application>
